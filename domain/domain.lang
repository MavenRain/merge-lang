collBoolTc x = elim (λ (y : Bool) → (p : Path Bool true y) → (q : Path Bool true y) → Path (Path Bool true y) (collBoolT y p) (collBoolT y q)) (λ (p : Path Bool true true) (q : Path Bool true true) → refl) (λ (p : Path Bool true false) (q : Path Bool true false) → absurdTF (Path (Path Bool true false) p q) p) x

