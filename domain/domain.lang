mvregRead n r s = gsetRead n (λ (x : Fin n) → mvregHas n r s x)

-- Ops A (S3b, Q41 (a)): a script of part operations. Each read and write
-- names its part by the part index. A read gives its answer to a function
-- (Read n for read, ℤ for stock). A write has its arguments and the next
-- step. A value of a set or a register and the replica of a transfer are a
-- Fin of an earlier field. A runner answers each read from the state and
-- applies each write (one elim, Q40 (a)).
data Ops (A : Type 0) : Type where
  opPure : (opOf : A) → Ops A
  opRead : (readN : ℕ) → (readPart : ℕ) → (readNext : Read readN → Ops A) → Ops A
  opStock : (stockPart : ℕ) → (stockNext : ℤ → Ops A) → Ops A
  opAdd : (addPart : ℕ) → (addN : ℕ) → (addValue : Fin addN) → (addNext : Ops A) → Ops A
  opWrite : (writePart : ℕ) → (writeN : ℕ) → (writeValue : Fin writeN) → (writeNext : Ops A) → Ops A
  opDec : (decPart : ℕ) → (decAmount : ℕ) → (decNext : Ops A) → Ops A
  opRestock : (restockPart : ℕ) → (restockAmount : ℕ) → (restockNext : Ops A) → Ops A
  opTransfer : (transferPart : ℕ) → (transferR : ℕ) → (transferTo : Fin transferR) → (transferAmount : ℕ) → (transferNext : Ops A) → Ops A

-- The product join (PLAN 4.1 and J3): a state is the Sigma of its parts. The
-- merge of a pair is the merge of each part. L1 to L3 of the pair follow from
-- L1 to L3 of each part by pair paths. Nest pairs for three or more parts.
pairMerge : (A : Type 0) → (B : Type 0) → (ma : A → A → A) → (mb : B → B → B) → (a : A × B) → (b : A × B) → A × B
pairMerge A B ma mb a b = pack (ma (witness a) (witness b)) (mb (payload a) (payload b))

pairIdem : (A : Type 0) → (B : Type 0) → (ma : A → A → A) → (mb : B → B → B) → (ia : (x : A) → Path A (ma x x) x) → (ib : (y : B) → Path B (mb y y) y) → (a : A × B) → Path (A × B) (pairMerge A B ma mb a a) a
pairIdem A B ma mb ia ib a i = pack (ia (witness a) i) (ib (payload a) i)

pairComm : (A : Type 0) → (B : Type 0) → (ma : A → A → A) → (mb : B → B → B) → (ca : (x : A) → (y : A) → Path A (ma x y) (ma y x)) → (cb : (x : B) → (y : B) → Path B (mb x y) (mb y x)) → (a : A × B) → (b : A × B) → Path (A × B) (pairMerge A B ma mb a b) (pairMerge A B ma mb b a)
pairComm A B ma mb ca cb a b i = pack (ca (witness a) (witness b) i) (cb (payload a) (payload b) i)

pairAssoc : (A : Type 0) → (B : Type 0) → (ma : A → A → A) → (mb : B → B → B) → (sa : (x : A) → (y : A) → (z : A) → Path A (ma (ma x y) z) (ma x (ma y z))) → (sb : (x : B) → (y : B) → (z : B) → Path B (mb (mb x y) z) (mb x (mb y z))) → (a : A × B) → (b : A × B) → (c : A × B) → Path (A × B) (pairMerge A B ma mb (pairMerge A B ma mb a b) c) (pairMerge A B ma mb a (pairMerge A B ma mb b c))
pairAssoc A B ma mb sa sb a b c i = pack (sa (witness a) (witness b) (witness c) i) (sb (payload a) (payload b) (payload c) i)

pairBot : (A : Type 0) → (B : Type 0) → (za : A) → (zb : B) → A × B
pairBot A B za zb = pack za zb

pairUnit : (A : Type 0) → (B : Type 0) → (ma : A → A → A) → (mb : B → B → B) → (za : A) → (zb : B) → (ua : (x : A) → Path A (ma za x) x) → (ub : (y : B) → Path B (mb zb y) y) → (a : A × B) → Path (A × B) (pairMerge A B ma mb (pairBot A B za zb) a) a
pairUnit A B ma mb za zb ua ub a i = pack (ua (witness a) i) (ub (payload a) i)

-- The finite multiset (S2c) and the generic merge of a multiset of states
-- (S2d, Q51 (a)). L5: a fold out of FMSet must agree with the unit,
-- associativity, commutativity and set paths, so the merge of a multiset
-- does not depend on the order. The set proofs use Hedberg (Q31 (a)).
data FMSet (A : Type 0) : Type where
  msing : (fmElem : A) → FMSet A
  mnil : FMSet A
  munion : (fmLeft : FMSet A) → (fmRight : FMSet A) → FMSet A
