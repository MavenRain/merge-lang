absurdTF : (T : Type 0) → Path Bool true false → T
absurdTF T e = transp (λ i → elim (λ (x : Bool) → Type 0) Bool T (e i)) i0 true

absurdFT : (T : Type 0) → Path Bool false true → T
absurdFT T e = transp (λ i → elim (λ (x : Bool) → Type 0) T Bool (e i)) i0 true

