collNatC : (a : ℕ) → (x : ℕ) → (p : Path ℕ a x) → (q : Path ℕ a x) → Path (Path ℕ a x) (collNat a x p) (collNat a x q)
collNatC a = fold (λ (c : ℕ) → (x : ℕ) → (p : Path ℕ c x) → (q : Path ℕ c x) → Path (Path ℕ c x) (collNat c x p) (collNat c x q)) (λ (k : ℕ) (ih : (x : ℕ) → (p : Path ℕ k x) → (q : Path ℕ k x) → Path (Path ℕ k x) (collNat k x p) (collNat k x q)) (x : ℕ) → fold (λ (y : ℕ) → (p : Path ℕ (natAdd k 1) y) → (q : Path ℕ (natAdd k 1) y) → Path (Path ℕ (natAdd k 1) y) (collNat (natAdd k 1) y p) (collNat (natAdd k 1) y q)) (λ (y : ℕ) (h : (p : Path ℕ (natAdd k 1) y) → (q : Path ℕ (natAdd k 1) y) → Path (Path ℕ (natAdd k 1) y) (collNat (natAdd k 1) y p) (collNat (natAdd k 1) y q)) (p : Path ℕ (natAdd k 1) (natAdd y 1)) (q : Path ℕ (natAdd k 1) (natAdd y 1)) j l → natAdd (ih y (λ m → natPred (p m)) (λ m → natPred (q m)) j l) 1) (λ (p : Path ℕ (natAdd k 1) 0) (q : Path ℕ (natAdd k 1) 0) → absurdSZ (Path (Path ℕ (natAdd k 1) 0) (collNat (natAdd k 1) 0 p) (collNat (natAdd k 1) 0 q)) k p) x) (λ (x : ℕ) → fold (λ (y : ℕ) → (p : Path ℕ 0 y) → (q : Path ℕ 0 y) → Path (Path ℕ 0 y) (collNat 0 y p) (collNat 0 y q)) (λ (y : ℕ) (h : (p : Path ℕ 0 y) → (q : Path ℕ 0 y) → Path (Path ℕ 0 y) (collNat 0 y p) (collNat 0 y q)) (p : Path ℕ 0 (natAdd y 1)) (q : Path ℕ 0 (natAdd y 1)) → absurdZS (Path (Path ℕ 0 (natAdd y 1)) (collNat 0 (natAdd y 1) p) (collNat 0 (natAdd y 1) q)) y p) (λ (p : Path ℕ 0 0) (q : Path ℕ 0 0) → refl) x) a

isSetNat : IsSet ℕ
isSetNat a = collSet ℕ a (collNat a) (collNatC a)

counterIsSet : (r : ℕ) → IsSet (Counter r)
counterIsSet r = isSetPair (Fin r → ℕ) (Fin r → ℕ) (isSetFun (Fin r) ℕ isSetNat) (isSetFun (Fin r) ℕ isSetNat)

escrowIsSet : (r : ℕ) → IsSet (Escrow r)
escrowIsSet r = isSetPair (Fin r → Fin r → ℕ) (Fin r → ℕ) (isSetFun (Fin r) (Fin r → ℕ) (isSetFun (Fin r) ℕ isSetNat)) (isSetFun (Fin r) ℕ isSetNat)

mvregIsSet : (n : ℕ) → (r : ℕ) → IsSet (MVReg n r)
mvregIsSet n r = isSetPair (Fin r → Fin n → ℕ) (Fin r → ℕ) (isSetFun (Fin r) (Fin n → ℕ) (isSetFun (Fin n) ℕ isSetNat)) (isSetFun (Fin r) ℕ isSetNat)

mergeAll : (S : Type 0) → (z : S) → (mg : S → S → S) → (u : (s : S) → Path S (mg z s) s) → (al : (s : S) → (t : S) → (w : S) → Path S (mg (mg s t) w) (mg s (mg t w))) → (cm : (s : S) → (t : S) → Path S (mg s t) (mg t s)) → (hs : IsSet S) → (m : FMSet S) → S
mergeAll S z mg u al cm hs m = fold (λ (e : S) → e) z (λ (g : S) (h : S) → mg g h) (λ (g : S) → u g) (λ (g : S) (h : S) (k : S) → al g h k) (λ (g : S) (h : S) → cm g h) (λ (g : S) (h : S) (p : Path S g h) (q : Path S g h) → hs g h p q) m

-- The multiset of the first n values of f (L5r, Q46 (b)): f 0, ..., f
-- (n - 1), one msing each.
fmOf : (A : Type 0) → (f : ℕ → A) → (n : ℕ) → FMSet A
fmOf A f n = fold (λ (k : ℕ) → FMSet A) (λ (k : ℕ) (x : FMSet A) → munion A x (msing A (f k))) (mnil A) n

-- The left merge of f 0, ..., f (n - 1) into s, in this order (L5r, Q46
-- (b)).
mergeSeq : (S : Type 0) → (mg : S → S → S) → (s : S) → (f : ℕ → S) → (n : ℕ) → S
mergeSeq S mg s f n = fold (λ (k : ℕ) → S) (λ (k : ℕ) (x : S) → mg x (f k)) s n

-- The left merge of f 0, ..., f (n - 1) into s is the merge of s with the
-- multiset of these values, for each order (L5r, Q46 (b)). The base is
-- the unit and commutativity laws, the step is the associativity law.
mergeSeqAll : (S : Type 0) → (z : S) → (mg : S → S → S) → (u : (s : S) → Path S (mg z s) s) → (al : (s : S) → (t : S) → (w : S) → Path S (mg (mg s t) w) (mg s (mg t w))) → (cm : (s : S) → (t : S) → Path S (mg s t) (mg t s)) → (hs : IsSet S) → (s : S) → (f : ℕ → S) → (n : ℕ) → Path S (mergeSeq S mg s f n) (mg s (mergeAll S z mg u al cm hs (fmOf S f n)))
mergeSeqAll S z mg u al cm hs s f n = fold (λ (k : ℕ) → Path S (mergeSeq S mg s f k) (mg s (mergeAll S z mg u al cm hs (fmOf S f k)))) (λ (k : ℕ) (ih : Path S (mergeSeq S mg s f k) (mg s (mergeAll S z mg u al cm hs (fmOf S f k)))) → trans (cong (λ (x : S) → mg x (f k)) ih) (al s (mergeAll S z mg u al cm hs (fmOf S f k)) (f k))) (symm (trans (cm s z) (u s))) n
