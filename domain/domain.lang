  trunc : (fmTruncS : FMSet A) → (fmTruncT : FMSet A) → (fmTruncP : Path (FMSet A) fmTruncS fmTruncT) → (fmTruncQ : Path (FMSet A) fmTruncS fmTruncT) → Path (Path (FMSet A) fmTruncS fmTruncT) fmTruncP fmTruncQ

collSet : (A : Type 0) → (a : A) → (f : (x : A) → Path A a x → Path A a x) → (fc : (x : A) → (p : Path A a x) → (q : Path A a x) → Path (Path A a x) (f x p) (f x q)) → (b : A) → (p : Path A a b) → (q : Path A a b) → Path (Path A a b) p q
