natPred : ℕ → ℕ
natPred n = fold (λ (k : ℕ) → ℕ) (λ (k : ℕ) (ih : ℕ) → k) 0 n

absurdZS : (T : Type 0) → (y : ℕ) → Path ℕ 0 (natAdd y 1) → T
absurdZS T y e = transp (λ i → fold (λ (k : ℕ) → Type 0) (λ (k : ℕ) (ih : Type 0) → T) Bool (e i)) i0 true

absurdSZ : (T : Type 0) → (y : ℕ) → Path ℕ (natAdd y 1) 0 → T
absurdSZ T y e = transp (λ i → fold (λ (k : ℕ) → Type 0) (λ (k : ℕ) (ih : Type 0) → Bool) T (e i)) i0 true

