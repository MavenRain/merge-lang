collBoolFc x = elim (λ (y : Bool) → (p : Path Bool false y) → (q : Path Bool false y) → Path (Path Bool false y) (collBoolF y p) (collBoolF y q)) (λ (p : Path Bool false true) (q : Path Bool false true) → absurdFT (Path (Path Bool false true) p q) p) (λ (p : Path Bool false false) (q : Path Bool false false) → refl) x

isSetBool : (a : Bool) → (b : Bool) → (p : Path Bool a b) → (q : Path Bool a b) → Path (Path Bool a b) p q
isSetBool a = elim (λ (c : Bool) → (b : Bool) → (p : Path Bool c b) → (q : Path Bool c b) → Path (Path Bool c b) p q) (collSet Bool true collBoolT collBoolTc) (collSet Bool false collBoolF collBoolFc) a

isSetFun : (A : Type 0) → (B : Type 0) → (h : (a : B) → (b : B) → (p : Path B a b) → (q : Path B a b) → Path (Path B a b) p q) → (f : A → B) → (g : A → B) → (p : Path (A → B) f g) → (q : Path (A → B) f g) → Path (Path (A → B) f g) p q
isSetFun A B h f g p q j i = λ (x : A) → h (f x) (g x) (λ l → p l x) (λ l → q l x) j i

gsetIsSet : (n : ℕ) → (a : GSet n) → (b : GSet n) → (p : Path (GSet n) a b) → (q : Path (GSet n) a b) → Path (Path (GSet n) a b) p q
gsetIsSet n = isSetFun (Fin n) Bool isSetBool

IsSet : (A : Type 0) → Type 0
IsSet A = (a : A) → (b : A) → (p : Path A a b) → (q : Path A a b) → Path (Path A a b) p q

isSetPair : (A : Type 0) → (B : Type 0) → (ha : IsSet A) → (hb : IsSet B) → IsSet (A × B)
