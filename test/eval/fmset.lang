-- FMSet (S2c U2): fmsetMap at points and at a 1-cell; a read of the bottom of each part.
fmsetMap : (A : Type 0) → (B : Type 0) → (f : A → B) → (s : FMSet A) → FMSet B
fmsetMap A B f s = fold (λ (e : A) → msing B (f e)) (mnil B) (λ (g : FMSet B) (h : FMSet B) → munion B g h) (λ (g : FMSet B) → munit B g) (λ (g : FMSet B) (h : FMSet B) (k : FMSet B) → massoc B g h k) (λ (g : FMSet B) (h : FMSet B) → mcomm B g h) (λ (g : FMSet B) (h : FMSet B) (p : Path (FMSet B) g h) (q : Path (FMSet B) g h) → trunc B g h p q) s

mapNil : FMSet ℕ
mapNil = fmsetMap ℕ ℕ (λ k → natAdd k 1) (mnil ℕ)

mapTwo : FMSet ℕ
mapTwo = fmsetMap ℕ ℕ (λ k → natAdd k 1) (munion ℕ (msing ℕ 1) (munion ℕ (msing ℕ 2) (mnil ℕ)))

mapComm : Path (FMSet ℕ) (munion ℕ (msing ℕ 2) (msing ℕ 3)) (munion ℕ (msing ℕ 3) (msing ℕ 2))
mapComm i = fmsetMap ℕ ℕ (λ k → natAdd k 1) (mcomm ℕ (msing ℕ 1) (msing ℕ 2) i)

botGs : ℕ
botGs = gsetCount 3 (gsetBot 3)

botCt : ℤ
botCt = counterStock 2 5 (counterBot 2)

botEs : ℤ
botEs = escrowStock 2 (λ j → 4) (escrowBot 2)

botMv : Read 3
botMv = mvregRead 3 2 (mvregBot 3 2)
