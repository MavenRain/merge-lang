-- The spine lowerings. Each Log here exists only at run time, so
-- `langc ir` walks its spine. The gate compares `langc eval` results.
logSum : (n : ℕ) → ℕ
logSum n = fold 0 (λ (top : ℕ) (acc : ℕ) → natAdd top acc) (fold (λ (s : Log) → logCons 5 s) logNil n)

-- The last logCons has a trapped rest.
logTrap : (n : ℕ) → ℕ
logTrap n = fold 0 (λ (top : ℕ) (acc : ℕ) → top) (fold (λ (s : Log) → logCons 5 s) (logCons 7 (fold (λ (s : Log) → s) logNil (natAdd 18446744073709551615 1))) n)

-- Consuming the recursive rest must propagate its trap.
logDemand : (n : ℕ) → ℕ
logDemand n = fold 0 (λ (top : ℕ) (acc : ℕ) → natAdd top acc) (fold (λ (s : Log) → logCons 5 s) (logCons 7 (fold (λ (s : Log) → s) logNil (natAdd 18446744073709551615 1))) n)
