replicas A B

atoms User := ana ∣ ben

atoms Amount := 1 ∣ 2

flip : User → User
flip u = flagIf (natEq (witness u) 0) ben ana

replicated Args
  state tags : GSet User
  state owner : MVReg User
  state stock : Counter (init 0)
  state bank : Counter (init 2)
  op fixed := add tags ana; write owner ben; restock stock 1; restock bank 1; transfer bank B 1
  op computed (u : User) (k : Amount) := add tags (flip u); write owner (flip u); restock stock (natAdd (AmountValue k) 1); transfer bank (flip u) 1
  op amount (k : Amount) := restock stock k
  allocate bank by escrow (A ↦ 1, B ↦ 1)
