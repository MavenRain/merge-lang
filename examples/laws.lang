-- Laws that the checker proves by normalization: each proof is refl.
leftFour : Option ℕ
leftFour = some 4

packed : ℕ × Bool
packed = pack 3 true

beta : Path ℕ ((λ (n : ℕ) → natMul n n) 6) 36
beta = refl

eta : Path ((n : ℕ) → ℕ) (λ (n : ℕ) → natAdd n 1) (λ (m : ℕ) → natAdd m 1)
eta = refl

leftUnit : Path (Option ℕ) (bind (pure 4) (λ (n : ℕ) → some (natAdd n 1))) (some 5)
leftUnit = refl

rightUnit : Path (Option ℕ) (bind (some 4) (λ (n : ℕ) → pure n)) (some 4)
rightUnit = refl

firstPair : Path ℕ (witness packed) 3
firstPair = refl

optionSome : Path ℕ (option 0 (λ (n : ℕ) → n) leftFour) 4
optionSome = refl

subFloor : Path ℕ (natSub 3 5) 0
subFloor = refl

flagTrue : Path ℕ (flagIf (natLe 2 3) 1 0) 1
flagTrue = refl

lotLaw : Path ℕ (lotPrice (makeLot 3 250)) 250
lotLaw = refl
