-- Dependent elim over Bool and Option: elim P yes no b and elim P z s o.
-- `or` and orIdem, orComm, orAssoc are library terms in domain/domain.lang.
pickE : (f : Bool) → (a : ℕ) → (b : ℕ) → ℕ
pickE f a b = elim (λ (x : Bool) → ℕ) a b f

someE : (f : Bool) → (a : ℕ) → ℕ
someE f a = elim (λ (o : Option ℕ) → ℕ) 7 (λ (x : ℕ) → natAdd x 1) (flagIf f (some a) none)

orIdemTrue : Path Bool (or true true) true
orIdemTrue = orIdem true

optionEta : (o : Option ℕ) → Path (Option ℕ) (option none (λ (a : ℕ) → some a) o) o
optionEta o = elim (λ (p : Option ℕ) → Path (Option ℕ) (option none (λ (a : ℕ) → some a) p) p) refl (λ (a : ℕ) → refl) o
