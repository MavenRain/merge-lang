-- natMax and induction over ℕ: fold M step base n.
-- natMaxIdem, natMaxComm, natMaxAssoc are library terms in domain/domain.lang.
natMaxOf : (a : ℕ) → (b : ℕ) → ℕ
natMaxOf a b = natMax a b

natMaxZero : (a : ℕ) → ℕ
natMaxZero a = natMax a 0

natMaxSucc : (a : ℕ) → (b : ℕ) → ℕ
natMaxSucc a b = natMax (natAdd a 1) (natAdd b 1)

natTri : (n : ℕ) → ℕ
natTri n = fold (λ (k : ℕ) → ℕ) (λ (k : ℕ) (acc : ℕ) → natAdd acc k) 0 n

natMaxZeroR : (a : ℕ) → Path ℕ (natMax a 0) a
natMaxZeroR a = refl

natMaxZeroL : (b : ℕ) → Path ℕ (natMax 0 b) b
natMaxZeroL b = refl

natMaxSuccSucc : (a : ℕ) → (b : ℕ) → Path ℕ (natMax (natAdd a 1) (natAdd b 1)) (natAdd (natMax a b) 1)
natMaxSuccSucc a b = refl

natMaxCommUse : (a : ℕ) → Path ℕ (natMax a 3) (natMax 3 a)
natMaxCommUse a = natMaxComm a 3
