-- Formers F12 and F13: paths, transport and congruence.
price : ℕ
price = 1200

cost : ℕ
cost = 1200

same : Path ℕ price cost
same = refl

back : Path ℕ cost price
back = symm same

round : Path ℕ price price
round = trans same back

moved : (P : (n : ℕ) → Type 0) → (u : P price) → P cost
moved P u = transport P same u

bumped : Path ℕ (natAdd price 1) (natAdd cost 1)
bumped = cong (λ (n : ℕ) → natAdd n 1) same

line : Path ℕ price cost
line i = price

atStart : ℕ
atStart = line i0

bumpLine : Path ℕ (natAdd price 1) (natAdd cost 1)
bumpLine i = natAdd (line i) 1
