-- The merge domain in use: a verdict, a log, a grow-only set and the
-- indexed data type Read (former F15).
verdict : Verdict
verdict = explicitConflict

verdictCode : ℕ
verdictCode = fold 1 2 3 verdict

independentFlag : ℕ
independentFlag = flagIf (fold true false false verdict) 1 0

log : Log
log = logCons 1 (logCons 2 logNil)

logLength : ℕ
logLength = fold 0 (λ (e : ℕ) (n : ℕ) → natAdd n 1) log

logTotal : ℕ
logTotal = fold 0 (λ (e : ℕ) (acc : ℕ) → natAdd e acc) log

added : ℕ
added = gsetCount 3 (gsetAdd 3 (pack 1 refl) (λ (x : Fin 3) → false))

read : Read 3
read = readEmpty 3

readCode : ℕ
readCode = fold 0 (λ (x : Fin 3) → natAdd (witness x) 1) (λ (c : (s : GSet 3) × Path Bool (natLe 2 (gsetCount 3 s)) true) → 100) (readOne 3 (pack 1 refl))
