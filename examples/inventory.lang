-- The sample domain in use, with the indexed data type Lot (former F15).
bolt : Item
bolt = makeItem red 3 10

nut : Item
nut = makeItem blue 1 40

boltTotal : ℕ
boltTotal = lineTotal bolt

boltRed : ℕ
boltRed = flagIf (isRed (itemColor bolt)) 1 0

nutRed : ℕ
nutRed = flagIf (isRed (itemColor nut)) 1 0

pile : Stack
pile = push 1 (push 2 bottom)

pileDepth : ℕ
pileDepth = depth pile

lot : Lot 3
lot = makeLot 3 250

lotCost : ℕ
lotCost = lotPrice lot
