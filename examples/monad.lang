-- Former F5: pure, map and bind over Option.
lifted : Option ℕ
lifted = map (λ (n : ℕ) → natAdd n 1) (some 4)

chained : Option ℕ
chained = bind (some 4) (λ (n : ℕ) → some (natMul n 2))

wrapped : Option ℕ
wrapped = pure 5

okRight : Option ℕ
okRight = map (λ (n : ℕ) → natAdd n 1) (some 3)

okBind : Option Bool
okBind = bind (some 3) (λ (n : ℕ) → some false)
